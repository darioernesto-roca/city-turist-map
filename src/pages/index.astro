---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildLocalizedPath, defaultLocale, localeNames, locales, t } from '../lib/i18n.js';

const lang = defaultLocale;
---
<BaseLayout
  title={t(lang, 'languageLandingTitle')}
  description={t(lang, 'languageLandingDescription')}
  lang={lang}
  canonicalPathOverride="/"
  includeAlternates={false}
>
  <section class="places-grid">
    <article class="place-card">
      <h1>{t(lang, 'languageLandingTitle')}</h1>
      <p>{t(lang, 'languageLandingDescription')}</p>
      <p>{t(lang, 'languageLandingHint')}</p>
      <div class="place-card-actions">
        {locales.map((locale) => (
          <a
            class="button-outline"
            href={buildLocalizedPath(locale, '/')}
            data-language-link
            data-language-value={locale}
          >
            {localeNames[locale]}
          </a>
        ))}
      </div>
    </article>
  </section>
  <script type="module" is:inline>
    document.querySelectorAll('[data-language-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const lang = link.dataset.languageValue;
        if (lang) {
          window.localStorage.setItem('preferredLanguage', lang);
        }
      });
    });
  </script>
</BaseLayout>
