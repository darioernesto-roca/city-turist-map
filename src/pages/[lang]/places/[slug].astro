---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { allPlaces, buildGoogleMapsLink, getLocalizedCategoryLabel } from '../../../lib/places.js';
import { buildLocalizedPath, getLocaleFromParams, getPlaceField, locales, t } from '../../../lib/i18n.js';

export async function getStaticPaths() {
  return locales.flatMap((lang) =>
    allPlaces.map((place) => ({
      params: { lang, slug: place.slug },
      props: { place, lang },
    }))
  );
}

const { place, lang: langProp } = Astro.props;
const lang = getLocaleFromParams({ lang: langProp });
const mapsLink = buildGoogleMapsLink(place.coords);
const placeName = getPlaceField(place, 'name', lang);
const placeShortDescription = getPlaceField(place, 'shortDescription', lang);
const placeLongDescription = getPlaceField(place, 'longDescription', lang);
const placeAddress = getPlaceField(place, 'address', lang);
---
<BaseLayout title={placeName} description={placeShortDescription} lang={lang}>
  <section class="place-detail">
    <a class="button-outline" href={buildLocalizedPath(lang, '/places')}>
      {t(lang, 'backToPlaces')}
    </a>

    <div>
      <span class="category-badge">{getLocalizedCategoryLabel(place.category, lang)}</span>
      <h1>{placeName}</h1>
      <p>{placeLongDescription || placeShortDescription}</p>
    </div>

    {place.image && <img src={place.image} alt={placeName} />}

    <div class="place-card-actions">
      <a class="button-primary" href={mapsLink} target="_blank" rel="noreferrer">{t(lang, 'openMaps')}</a>
      {place.website && (
        <a class="button-outline" href={place.website} target="_blank" rel="noreferrer">
          {t(lang, 'visitWebsite')}
        </a>
      )}
      <button class="button-outline" type="button">{t(lang, 'bookBuy')}</button>
    </div>

    {placeAddress && (
      <p>
        <strong>{t(lang, 'addressLabel')}</strong> {placeAddress}
      </p>
    )}
  </section>
</BaseLayout>
